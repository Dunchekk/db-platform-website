// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}


model Admin {
  id           Int      @id @default(autoincrement())
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
}

model Item {
  id          Int          @id @default(autoincrement())
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  name        String
  price       Int
  position    Int
  packageWeightGrams Int
  packageLengthCm    Int
  packageWidthCm     Int
  packageHeightCm    Int

  points      ItemPoint[]
  info        ItemInfo[]
  images      ItemImage[]
  orderItems  OrderItem[]
}

model ItemPoint {
  id          Int    @id @default(autoincrement())
  itemId      Int
  point       String

  item        Item   @relation(fields: [itemId], references: [id], onDelete: Cascade)
  @@index([itemId])
}

model ItemInfo {
  id          Int    @id @default(autoincrement())
  itemId      Int
  title       String
  description String

  item        Item   @relation(fields: [itemId], references: [id], onDelete: Cascade)
  @@index([itemId])
}

model ItemImage {
  id       Int     @id @default(autoincrement())
  url      String
  itemId   Int
  position Int     @default(0)

  item     Item    @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@index([itemId])
}

enum OrderStatus {
  PENDING_PAYMENT
  PAID
  FULFILLMENT_PENDING
  SHIPPED
  DELIVERED
  CANCELLED
}

enum PaymentProvider {
  YOOKASSA
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  CANCELED
  FAILED
  PROVIDER_UNKNOWN
}

enum ShipmentStatus {
  PENDING
  CREATED
  IN_TRANSIT
  READY_FOR_PICKUP
  DELIVERED
  CANCELED
  FAILED
}

enum DeliveryMethod {
  CDEK_PVZ
  CDEK_POSTAMAT
}

enum NotificationJobType {
  SHIPMENT_CREATED_EMAIL
}

enum NotificationJobStatus {
  PENDING
  PROCESSING
  SENT
  FAILED
}

model Order {
  id                 Int         @id @default(autoincrement())
  status             OrderStatus @default(PENDING_PAYMENT)
  checkoutAttemptKey String?     @unique
  currentPaymentId   Int?        @unique

  firstName          String
  lastName           String
  patronymic         String?
  email              String
  phone              String
  telegram           String?
  
  deliveryMethod        DeliveryMethod
  deliveryPrice         Int             @default(0)
  deliveryCityCode      Int
  deliveryCityLabel     String
  deliveryOfficeCode    String
  deliveryOfficeUuid    String?
  deliveryOfficeType    String?
  deliveryOfficeAddress String

  comment                       String?
  subtotal                      Int
  total                         Int
  offerAcceptedAt               DateTime?
  offerVersion                  String?
  personalDataConsentAcceptedAt DateTime?
  personalDataConsentVersion    String?

  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt

  items              OrderItem[]
  payments           Payment[]   @relation("OrderPayments")
  currentPayment     Payment?    @relation("OrderCurrentPayment", fields: [currentPaymentId], references: [id], onDelete: SetNull)
  shipments          Shipment[]
  notificationJobs   NotificationJob[]
}

model OrderItem {
  id          Int    @id @default(autoincrement())
  orderId     Int
  itemId      Int?
  title       String
  price       Int
  quantity    Int
  total       Int
  packageWeightGrams Int
  packageLengthCm    Int
  packageWidthCm     Int
  packageHeightCm    Int

  order       Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  item        Item?  @relation(fields: [itemId], references: [id], onDelete: SetNull)

  @@index([orderId])
}

model Payment {
  id                Int             @id @default(autoincrement())
  orderId           Int
  provider          PaymentProvider @default(YOOKASSA)
  status            PaymentStatus   @default(PENDING)
  amount            Int
  currency          String          @default("RUB")
  providerPaymentId String?         @unique
  idempotenceKey    String?         @unique
  confirmationUrl   String?
  paidAt            DateTime?
  canceledAt        DateTime?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  order             Order           @relation("OrderPayments", fields: [orderId], references: [id], onDelete: Cascade)
  currentForOrder   Order?          @relation("OrderCurrentPayment")

  @@index([orderId])
  @@index([status])
}

model Shipment {
  id                  Int            @id @default(autoincrement())
  orderId             Int            @unique
  status              ShipmentStatus @default(PENDING)
  provider            String         @default("CDEK")
  providerShipmentId  String?
  trackingNumber      String?
  trackingUrl         String?
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt

  order               Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  notificationJobs    NotificationJob[]

  @@index([orderId])
  @@index([status])
}

model NotificationJob {
  id         Int                   @id @default(autoincrement())
  type       NotificationJobType
  status     NotificationJobStatus @default(PENDING)
  orderId    Int
  shipmentId Int?
  attempts   Int                   @default(0)
  runAt      DateTime              @default(now())
  lockedAt   DateTime?
  lastError  String?
  sentAt     DateTime?
  createdAt  DateTime              @default(now())
  updatedAt  DateTime              @updatedAt

  order      Order                 @relation(fields: [orderId], references: [id], onDelete: Cascade)
  shipment   Shipment?             @relation(fields: [shipmentId], references: [id], onDelete: SetNull)

  @@unique([type, orderId])
  @@index([status, runAt])
  @@index([shipmentId])
}
